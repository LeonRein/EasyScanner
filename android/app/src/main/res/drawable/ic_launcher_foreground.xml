<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a ChArUco board tile with a laser line whose
  profile bulges over a scanned object. Drawn on the 108dp adaptive icon
  grid; the artwork stays inside the 66dp safe zone except for the laser
  ends, which may be cropped by round masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ChArUco board tile: light base, dark squares and one ArUco marker. -->
    <group android:name="board">
        <clip-path android:pathData="M34,27L74,27A7,7 0,0 1,81,34L81,74A7,7 0,0 1,74,81L34,81A7,7 0,0 1,27,74L27,34A7,7 0,0 1,34,27Z" />
        <path
            android:fillColor="@color/ic_launcher_board_light"
            android:pathData="M27,27h54v54h-54z" />
        <path
            android:fillColor="@color/ic_launcher_board_dark"
            android:pathData="M45,27h18v18h-18z M27,45h18v18h-18z M63,45h18v18h-18z M45,63h18v18h-18z M48,48h12v12h-12z" />
        <path
            android:fillColor="@color/ic_launcher_board_light"
            android:pathData="M50.4,50.4h2.4v2.4h-2.4z M55.2,50.4h2.4v2.4h-2.4z M52.8,52.8h2.4v2.4h-2.4z M50.4,55.2h2.4v2.4h-2.4z M52.8,55.2h2.4v2.4h-2.4z" />
    </group>

    <!-- Laser line, layered from the outer glow to the hot core. -->
    <group android:name="laser">
        <path
            android:pathData="M22,64L34,64C44,64 47,46 54,46C61,46 64,64 74,64L86,64"
            android:strokeColor="@color/ic_launcher_laser"
            android:strokeAlpha="0.22"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M22,64L34,64C44,64 47,46 54,46C61,46 64,64 74,64L86,64"
            android:strokeColor="@color/ic_launcher_laser"
            android:strokeAlpha="0.35"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M22,64L34,64C44,64 47,46 54,46C61,46 64,64 74,64L86,64"
            android:strokeColor="@color/ic_launcher_laser_core"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M22,64L34,64C44,64 47,46 54,46C61,46 64,64 74,64L86,64"
            android:strokeColor="@color/ic_launcher_laser_hot"
            android:strokeWidth="0.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
